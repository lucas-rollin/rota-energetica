{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BiomethanePlant": {
      "additionalProperties": false,
      "description": "ANP-authorized biomethane production facility.",
      "properties": {
        "id": {
          "description": "Identificador único da unidade produtora.",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "Nome da usina ou unidade operacional.",
          "title": "Name",
          "type": "string"
        },
        "operator": {
          "description": "Empresa ou grupo operador.",
          "title": "Operator",
          "type": "string"
        },
        "city": {
          "description": "Município de localização.",
          "title": "City",
          "type": "string"
        },
        "state": {
          "description": "Unidade Federativa (UF).",
          "title": "State",
          "type": "string"
        },
        "feedstock": {
          "description": "Substrato agroindustrial ou resíduo base.",
          "title": "Feedstock",
          "type": "string"
        },
        "daily_capacity_nm3_day": {
          "description": "Capacidade autorizada de produção diária em Nm³/dia.",
          "exclusiveMinimum": 0,
          "title": "Daily Capacity (Nm³/day)",
          "type": "integer"
        },
        "logistics_modal": {
          "description": "Modal logístico de escoamento.",
          "title": "Logistics Modal",
          "type": "string"
        },
        "status": {
          "description": "Status de operação da usina.",
          "title": "Status",
          "type": "string"
        },
        "grid_connection": {
          "description": "Conexão com a rede de gás canalizado ou transporte.",
          "title": "Grid Connection",
          "type": "string"
        },
        "source_id": {
          "description": "ID da fonte no catálogo de fontes.",
          "pattern": "^[A-Z][0-9]{2}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "operator",
        "city",
        "state",
        "feedstock",
        "daily_capacity_nm3_day",
        "logistics_modal",
        "status",
        "grid_connection",
        "source_id"
      ],
      "title": "BiomethanePlant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Catalog of ANP-authorized biomethane production plants.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "../../schemas/biomethane_plants.schema.json",
      "title": "$schema"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "generated_at": {
      "description": "Data de geração do catálogo.",
      "title": "Generated At",
      "type": "string"
    },
    "total_installed_capacity_nm3_day": {
      "description": "Capacidade diária total consolidada em Nm³/dia.",
      "exclusiveMinimum": 0,
      "title": "Total Installed Capacity (Nm³/day)",
      "type": "integer"
    },
    "plants": {
      "description": "Relação de usinas autorizadas pela ANP.",
      "items": {
        "$ref": "#/$defs/BiomethanePlant"
      },
      "title": "Plants",
      "type": "array"
    }
  },
  "required": [
    "generated_at",
    "total_installed_capacity_nm3_day",
    "plants"
  ],
  "title": "BiomethanePlantsCatalog",
  "type": "object"
}
