---
import Layout from '../layouts/Layout.astro';
import { CorridorsDashboard } from '../components/corridors/CorridorsDashboard';
import { CorridorInfrastructureMap } from '../components/corridors/CorridorInfrastructureMap';
import { TransparencyDisclaimer } from '../components/common/TransparencyDisclaimer';
import corridorsJson from '../../../data/processed/corridors.json';
import stationsJson from '../../../data/processed/corridor_fuel_stations.json';
import type {
  CorridorFuelStationsCatalog,
  CorridorsCatalog,
} from '../lib/types/catalogs';

const corridorsData = corridorsJson as unknown as CorridorsCatalog;
const stationsData = stationsJson as unknown as CorridorFuelStationsCatalog;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="Corredores Logísticos & Infraestrutura — Rota Energética"
  description="Modelagem territorial de corredores rodoviários de carga, mapa interativo de postos de biometano/GNV e eletropostos HPC com anéis de autonomia e Lei da Balança."
>
  <div class="space-y-6">
    <!-- Breadcrumbs & Page Header -->
    <div class="border-b border-base-200 pb-4">
      <div class="breadcrumbs text-xs text-base-content/75 mb-2">
        <ul>
          <li>
            <a href={baseUrl}>Início</a>
          </li>
          <li>Corredores & Infraestrutura</li>
        </ul>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-base-content tracking-tight">
        Corredores Estratégicos & Prontidão de Abastecimento
      </h1>
      <p class="mt-1 text-sm sm:text-base text-base-content/75 max-w-3xl">
        Diagnóstico operacional e territorial das rotas de carga no Brasil. Compare a
        cobertura de postos de GNV/biometano e eletropostos HPC (&gt;150 kW) com anéis
        dinâmicos de autonomia e o impacto da bateria na Lei da Balança.
      </p>
    </div>

    <!-- Interactive Corridors Feasibility Dashboard -->
    <CorridorsDashboard
      client:load
      corridorsData={corridorsData}
      stationsData={stationsData}
    />

    <!-- Lazy-hydrated Highway Infrastructure & Autonomy Coverage Map (GeoJSON loaded client-side) -->
    <CorridorInfrastructureMap
      client:visible
      corridors={corridorsData.corridors}
      stations={stationsData.stations}
    />

    <TransparencyDisclaimer />
  </div>
</Layout>
