---
import Layout from '../layouts/Layout.astro';
import { CorridorsDashboard } from '../components/corridors/CorridorsDashboard';
import corridorsJson from '../../../data/processed/corridors.json';
import plantsJson from '../../../data/processed/biomethane_plants.json';
import type { BiomethanePlantsCatalog, CorridorsCatalog } from '../lib/types/catalogs';

const corridorsData = corridorsJson as unknown as CorridorsCatalog;
const biomethanePlantsData = plantsJson as unknown as BiomethanePlantsCatalog;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="Corredores Logísticos & Infraestrutura — Rota Energética"
  description="Modelagem territorial de corredores rodoviários de carga, disponibilidade de gás e biometano, recarga rápida e viabilidade física pela Lei da Balança."
>
  <div class="space-y-6">
    <!-- Breadcrumbs & Page Header -->
    <div class="border-b border-base-200 pb-4">
      <div class="breadcrumbs text-xs text-base-content/60 mb-2">
        <ul>
          <li><a href={baseUrl}>Início</a></li>
          <li>Corredores & Infraestrutura</li>
        </ul>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-base-content tracking-tight">
        Corredores Estratégicos & Prontidão de Abastecimento
      </h1>
      <p class="mt-1 text-sm sm:text-base text-base-content/75 max-w-3xl">
        Diagnóstico operacional de rotas de escoamento de safra e carga geral no Brasil. Compare a maturidade de postos de biometano/GNC, eletropostos HPC (&gt;150kW) e o impacto de peso da bateria na carga líquida útil.
      </p>
    </div>

    <!-- Interactive Corridors & Plants Dashboard -->
    <CorridorsDashboard client:load corridorsData={corridorsData} biomethanePlantsData={biomethanePlantsData} />
  </div>
</Layout>
