---
import Layout from '../layouts/Layout.astro';
import { ArrowDown, ArrowRight, Calculator, Leaf, ShieldCheck } from 'lucide-react';
import Simulator from '../components/simulator/Simulator';
import { PriceHistoryChart } from '../components/simulator/charts/PriceHistoryChart';
import { EsgDashboard } from '../components/esg/EsgDashboard';
import { CorridorsDashboard } from '../components/corridors/CorridorsDashboard';
import { CorridorInfrastructureMap } from '../components/corridors/CorridorInfrastructureMap';
import { GlobalBenchmarkDashboard } from '../components/global/GlobalBenchmarkDashboard';
import parametersJson from '../../../data/parameters.json';
import pollutantsJson from '../../../data/processed/local_pollutants.json';
import corridorsJson from '../../../data/processed/corridors.json';
import stationsJson from '../../../data/processed/corridor_fuel_stations.json';
import benchmarksJson from '../../../data/processed/global_benchmarks.json';
import type { SimulationParameters } from '../lib/types';
import type {
  CorridorFuelStationsCatalog,
  CorridorsCatalog,
  GlobalBenchmarksCatalog,
  LocalPollutantsCatalog,
} from '../lib/types/catalogs';

const defaults = parametersJson as unknown as SimulationParameters;
const pollutantsData = pollutantsJson as unknown as LocalPollutantsCatalog;
const corridorsData = corridorsJson as unknown as CorridorsCatalog;
const stationsData = stationsJson as unknown as CorridorFuelStationsCatalog;
const benchmarksData = benchmarksJson as unknown as GlobalBenchmarksCatalog;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout
  fullWidth={true}
  title="Rota Energética — Simulador Educacional de Transição em Frotas Pesadas"
  description="Ferramenta interativa de cálculo de TCO, histórico de preços, emissões Poço-à-Roda e infraestrutura de corredores para cavalos mecânicos rodoviários: Diesel B15, GNV, Biometano e Elétrico."
>
  <!-- Band 1: Editorial Hero + Compact Methodology Strip -->
  <div class="bg-base-100">
    <div class="mx-auto max-w-7xl space-y-7 px-4 py-7 sm:px-6 sm:py-9 lg:px-8">
      <!-- 1. Hero -->
      <section id="topo" aria-labelledby="hero-title" class="scroll-mt-16">
        <div class="max-w-3xl space-y-3.5">
          <span class="text-primary block text-xs font-semibold tracking-wider uppercase">
            Projeto de Extensão Universitária
          </span>

          <h1
            id="hero-title"
            class="text-base-content text-3xl font-black tracking-tight sm:text-4xl"
          >
            Rota Energética
          </h1>

          <p class="text-base-content/80 text-base leading-relaxed sm:text-lg">
            Compare <strong>Diesel B15</strong>, <strong>GNV</strong>,{' '}
            <strong>Biometano</strong> e <strong>Elétrico</strong> em frotas pesadas:
            custo por km, retorno do investimento e emissões do poço à roda.
          </p>

          <div class="flex flex-wrap items-center gap-2.5 pt-1">
            <a href="#simulador" class="btn btn-primary btn-sm gap-2 font-semibold">
              <span>Abrir simulador</span>
              <ArrowDown className="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
            </a>
            <a href={`${baseUrl}fontes`} class="btn btn-ghost btn-sm gap-1.5">
              <span>Fontes &amp; parâmetros</span>
              <ArrowRight className="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
            </a>
          </div>
        </div>
      </section>

      <!-- 2. Compact Methodology Strip -->
      <section
        id="metodologia"
        aria-labelledby="metodologia-heading"
        class="border-base-300/70 scroll-mt-16 space-y-3 border-t pt-6"
      >
        <div class="flex items-baseline justify-between gap-2">
          <h2
            id="metodologia-heading"
            class="text-base-content text-sm font-bold tracking-tight"
          >
            <span class="text-primary mr-1.5 font-mono text-xs">01</span>
            Como o modelo calcula
          </h2>
          <a
            href={`${baseUrl}fontes`}
            class="link link-primary inline-flex items-center gap-1 text-xs font-medium"
          >
            <span>Metodologia completa</span>
            <ArrowRight className="h-3 w-3 shrink-0" aria-hidden="true" />
          </a>
        </div>

        <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
          <article class="bg-base-200/50 border-base-300/60 flex items-start gap-3 rounded-xl border p-3.5">
            <span class="bg-primary/10 text-primary mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg">
              <Calculator className="h-3.5 w-3.5" aria-hidden="true" />
            </span>
            <div class="space-y-0.5">
              <h3 class="text-base-content text-xs font-bold">TCO descontado (R$/km)</h3>
              <p class="text-base-content/75 text-xs leading-relaxed">
                Compra + energia, manutenção e ARLA trazidos a valor presente, descontada
                a revenda.
              </p>
            </div>
          </article>

          <article class="bg-base-200/50 border-base-300/60 flex items-start gap-3 rounded-xl border p-3.5">
            <span class="bg-primary/10 text-primary mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg">
              <Leaf className="h-3.5 w-3.5" aria-hidden="true" />
            </span>
            <div class="space-y-0.5">
              <h3 class="text-base-content text-xs font-bold">Emissões Poço à Roda</h3>
              <p class="text-base-content/75 text-xs leading-relaxed">
                Ciclo completo (gCO₂eq/MJ) da produção ao uso, por fatores CNPE e matriz
                do SIN.
              </p>
            </div>
          </article>

          <article class="bg-base-200/50 border-base-300/60 flex items-start gap-3 rounded-xl border p-3.5">
            <span class="bg-primary/10 text-primary mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg">
              <ShieldCheck className="h-3.5 w-3.5" aria-hidden="true" />
            </span>
            <div class="space-y-0.5">
              <h3 class="text-base-content text-xs font-bold">Fontes rastreáveis</h3>
              <p class="text-base-content/75 text-xs leading-relaxed">
                Cada premissa exibe código clicável (<code>P01</code>, <code>E01</code>…)
                e selo Primária, Adaptada ou Ilustrativa.
              </p>
            </div>
          </article>
        </div>
      </section>
    </div>
  </div>

  <!-- Band 2: Interactive TCO Simulator -->
  <section
    id="simulador"
    aria-labelledby="simulador-heading"
    class="bg-base-200/60 border-base-300/70 scroll-mt-14 border-t py-8 sm:py-10"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-4">
        <span class="text-primary text-xs font-bold tracking-wider uppercase">
          02 · Simulador TCO
        </span>
        <h2
          id="simulador-heading"
          class="text-base-content text-xl font-extrabold tracking-tight sm:text-2xl"
        >
          Custos, Payback e Premissas de Frota
        </h2>
      </div>

      <Simulator client:load defaults={defaults} showDisclaimer={true} />
    </div>
  </section>

  <!-- Band 3: Weekly Historical Fuel Prices -->
  <section
    id="historico"
    aria-labelledby="historico-heading"
    class="bg-base-100 border-base-300/70 scroll-mt-14 border-t py-8 sm:py-10"
  >
    <div class="mx-auto max-w-7xl space-y-4 px-4 sm:px-6 lg:px-8">
      <div>
        <span class="text-primary text-xs font-bold tracking-wider uppercase">
          03 · Histórico de Preços
        </span>
        <h2
          id="historico-heading"
          class="text-base-content text-xl font-extrabold tracking-tight sm:text-2xl"
        >
          Série Histórica de Combustíveis (ANP &amp; EIA)
        </h2>
      </div>

      <PriceHistoryChart client:visible />
    </div>
  </section>

  <!-- Band 4: Lifecycle Emissions & Local Pollutants -->
  <section
    id="emissoes"
    aria-labelledby="emissoes-heading"
    class="bg-base-200/60 border-base-300/70 scroll-mt-14 border-t py-8 sm:py-10"
  >
    <div class="mx-auto max-w-7xl space-y-4 px-4 sm:px-6 lg:px-8">
      <div>
        <span class="text-primary text-xs font-bold tracking-wider uppercase">
          04 · Emissões &amp; ESG
        </span>
        <h2
          id="emissoes-heading"
          class="text-base-content text-xl font-extrabold tracking-tight sm:text-2xl"
        >
          Ciclo de Vida, Escopos GHG e Poluentes Locais
        </h2>
      </div>

      <EsgDashboard
        client:visible
        parameters={defaults}
        pollutantsData={pollutantsData}
        showDisclaimer={false}
      />
    </div>
  </section>

  <!-- Band 5: Strategic Corridors & Infrastructure Map -->
  <section
    id="corredores"
    aria-labelledby="corredores-heading"
    class="bg-base-100 border-base-300/70 scroll-mt-14 border-t py-8 sm:py-10"
  >
    <div class="mx-auto max-w-7xl space-y-4 px-4 sm:px-6 lg:px-8">
      <div>
        <span class="text-primary text-xs font-bold tracking-wider uppercase">
          05 · Corredores &amp; Infraestrutura
        </span>
        <h2
          id="corredores-heading"
          class="text-base-content text-xl font-extrabold tracking-tight sm:text-2xl"
        >
          Viabilidade Operacional e Mapa de Abastecimento
        </h2>
      </div>

      <CorridorsDashboard
        client:visible
        corridorsData={corridorsData}
        stationsData={stationsData}
      />

      <CorridorInfrastructureMap
        client:visible
        corridors={corridorsData.corridors}
        stations={stationsData.stations}
      />
    </div>
  </section>

  <!-- Band 6: Global Benchmark -->
  <section
    id="benchmark-global"
    aria-labelledby="global-heading"
    class="bg-base-200/60 border-base-300/70 scroll-mt-14 border-t py-8 sm:py-10"
  >
    <div class="mx-auto max-w-7xl space-y-4 px-4 sm:px-6 lg:px-8">
      <div>
        <span class="text-primary text-xs font-bold tracking-wider uppercase">
          06 · Contexto Internacional
        </span>
        <h2
          id="global-heading"
          class="text-base-content text-xl font-extrabold tracking-tight sm:text-2xl"
        >
          Brasil vs. União Europeia vs. EUA vs. China
        </h2>
      </div>

      <GlobalBenchmarkDashboard
        client:visible
        benchmarksData={benchmarksData}
        parameters={defaults}
        showDisclaimer={false}
      />
    </div>
  </section>
</Layout>
