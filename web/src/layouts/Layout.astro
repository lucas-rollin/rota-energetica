---
import '../styles/global.css';
import { GlobalSourceModal } from '../components/common/SourceModal';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rota Energética',
  description = 'Simulador educacional de transição energética para frotas pesadas de transporte de carga.',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const currentPath = Astro.url.pathname;

const navItems = [
  {
    href: baseUrl,
    label: 'Simulador TCO',
    match: (p: string) => p === baseUrl || p === `${baseUrl}index.html` || p === '/',
  },
  {
    href: `${baseUrl}pollutants-esg`,
    label: 'Emissões & ESG',
    match: (p: string) => p.includes('pollutants-esg'),
  },
  {
    href: `${baseUrl}corridors`,
    label: 'Corredores & Infra',
    match: (p: string) => p.includes('corridors'),
  },
  {
    href: `${baseUrl}global-benchmarks`,
    label: 'Benchmark Global',
    match: (p: string) => p.includes('global-benchmarks'),
  },
  {
    href: `${baseUrl}fontes`,
    label: 'Fontes & Licenças',
    match: (p: string) => p.includes('fontes'),
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="icon" href={`${baseUrl}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme =
            stored === 'dark' || stored === 'light'
              ? stored
              : prefersDark
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch {
          // Ignore storage/matchMedia errors in restricted contexts
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-base-200/40 text-base-content antialiased">
    <!-- Extension Project Header Notice -->
    <header class="w-full bg-base-100 border-b border-base-200 sticky top-0 z-30 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-3">
            <a
              href={baseUrl}
              class="flex items-center gap-2.5 font-bold text-lg text-base-content tracking-tight hover:opacity-85 transition-opacity"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 32 32"
                fill="none"
                class="w-8 h-8 shrink-0 rounded-lg shadow-xs"
                aria-hidden="true"
              >
                <rect width="32" height="32" rx="7" fill="#031427" />
                <path
                  d="M10 26L14 14H18L22 26"
                  stroke="#4edea3"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <path
                  d="M16 16V18M16 22V25"
                  stroke="#4edea3"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  opacity="0.6"
                />
                <path
                  d="M17 5L12 12H16L15 16L20 9H16L17 5Z"
                  fill="#4cd7f6"
                  stroke="#031427"
                  stroke-width="0.5"
                  stroke-linejoin="round"
                />
              </svg>
              <span>Rota Energética</span>
            </a>
          </div>

          <div class="flex items-center gap-1 sm:gap-1.5 min-w-0">
            <nav
              aria-label="Navegação principal"
              class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto py-1 max-w-full"
            >
              {navItems.map((item) => {
                const active = item.match(currentPath);
                return (
                  <a
                    href={item.href}
                    class={`btn btn-sm text-xs font-semibold whitespace-nowrap transition-colors ${
                      active
                        ? 'text-primary font-bold shadow-xs'
                        : 'btn-ghost text-base-content/85 hover:text-base-content'
                    }`}
                  >
                    {item.label}
                  </a>
                );
              })}
            </nav>

            <label
              class="swap swap-rotate btn btn-ghost btn-sm btn-square text-base-content shrink-0 ml-1"
              title="Alternar tema claro/escuro"
            >
              <input
                id="theme-controller"
                type="checkbox"
                class="theme-controller"
                value="dark"
                aria-label="Alternar modo escuro"
              />
              <!-- Sun icon (light mode) -->
              <svg
                class="swap-off h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
              <!-- Moon icon (dark mode) -->
              <svg
                class="swap-on h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
            </label>

            <a
              href="https://github.com/lucas-rollin/rota-energetica"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Repositório no GitHub (abre em nova aba)"
              class="btn btn-ghost btn-sm btn-square text-base-content shrink-0"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full bg-base-100 border-t border-base-200 py-8 mt-12 text-xs text-base-content/70">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
        <div>
          <p class="font-bold text-sm text-base-content mb-1">Rota Energética</p>
          <p>
            Simulador educacional de transição para alternativas de baixa emissão em
            transporte pesado de carga.
          </p>
          <p class="mt-1 text-[11px] text-base-content/75">
            Estimativas para fins acadêmicos. Ver{' '}
            <a href={`${baseUrl}fontes`} class="link link-primary">
              Fontes & Licenças
            </a>{' '}
            e{' '}
            <a
              href="https://github.com/lucas-rollin/rota-energetica/blob/main/LICENSE-DATA.md"
              target="_blank"
              rel="noopener noreferrer"
              class="link link-primary"
            >
              LICENSE-DATA.md
            </a>
            .
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-xs">
          <a href={`${baseUrl}fontes`} class="link link-hover">
            Fontes & Metadados
          </a>
          <a
            href="https://github.com/lucas-rollin/rota-energetica"
            target="_blank"
            rel="noopener noreferrer"
            class="link link-hover"
          >
            Código-fonte (MIT)
          </a>
        </div>
      </div>
    </footer>

    <GlobalSourceModal client:load />

    <script is:inline>
      (() => {
        const toggle = document.getElementById('theme-controller');
        if (!(toggle instanceof HTMLInputElement)) return;

        const syncToggle = () => {
          toggle.checked = document.documentElement.getAttribute('data-theme') === 'dark';
        };

        syncToggle();

        toggle.addEventListener('change', () => {
          const next = toggle.checked ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch {
            // Ignore storage errors
          }
        });

        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        mq.addEventListener('change', (e) => {
          try {
            if (localStorage.getItem('theme')) return;
          } catch {
            // Ignore storage errors
          }
          document.documentElement.setAttribute(
            'data-theme',
            e.matches ? 'dark' : 'light'
          );
          syncToggle();
        });
      })();
    </script>
  </body>
</html>
